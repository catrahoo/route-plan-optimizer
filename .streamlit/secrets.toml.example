# Copy semua ini ke Streamlit → Manage app → ⋮ → Settings → Secrets, lalu ganti nilainya.
# JANGAN commit file secrets.toml asli ke GitHub.

# Password untuk masuk aplikasi (kosongkan baris ini kalau tidak pakai password)
APP_PASSWORD = "password-tim"

[supabase]
url = "https://xxxx.supabase.co"
key = "sb_secret_xxxx"

# Opsional: OpenRouteService untuk jarak ikut jalan (Plan B). Daftar gratis di openrouteservice.org
[ors]
key = "ISI_API_KEY_ORS"
